# Chain credit, throws, hits and the audit through one round.
mode tankbank
tune HitDropCount=1 RagdollDropCount=5 HitGraceTime=0.5
actors 1=0 2=0 3=0
phase countdown ends=4
expect open false
phase round ends=150
expect last snapshot
now 10
expect open true
detonate 1 map
detonate 1 map
detonate 1 map
expect last score 1 3 +1
detonate 2 drop
expect bank 1=3 2=1 3=0
spill 1 1 thrown 3
expect last reserved 1/1 3
register 1 1
expect last score 1 0 -3; committed 1/1 thrown 3
detonate 3 drop
detonate 3 drop
spill 3 1 hit 2
expect last canceled 3/1 exceeds
spill 3 2 hit 1
register 3 2
expect stats 1=3/0/3 2=1/0/0 3=2/1/0
expect standings 2=1 3=1 1=0
expect audit initial=0 map=3 drops=3 spills=4 banked=2 expected=2 ok=True
now 150
expect open false
spill 2 1 hit 1
expect last canceled 2/1 closed
phase roundend
expect last end match
