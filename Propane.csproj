<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Propane</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Pin the baseline to .NET 10; favor correctness over API design and style suggestions. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>10.0</AnalysisLevel>
    <!-- CA2000/CA2213 cannot distinguish scene-tree/reference-counted ownership from CLR ownership.
         Recommended reliability plus CA1001 checks ownership without flagging engine allocations. -->
    <AnalysisLevelReliability>10.0-recommended</AnalysisLevelReliability>
    <AnalysisLevelUsage>10.0-recommended</AnalysisLevelUsage>
    <AnalysisLevelSecurity>10.0-recommended</AnalysisLevelSecurity>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- build/ holds release output, logs and scratch copies of the project; never compile them. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);build/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
