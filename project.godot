; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Propane"
config/description="Run around a procedural suburb and shoot propane tanks."
config/version="0.2.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"
run/flush_stdout_on_print=true

[autoload]

; First means last to be freed, after scene resources have become collectible.
ShutdownGuard="*res://src/Core/ShutdownGuard.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Propane"

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Props"
3d_physics/layer_3="Tanks"
3d_physics/layer_4="Debris"
3d_physics/layer_5="Player"
3d_physics/layer_6="Ragdoll"
3d_physics/layer_7="Floor"

[physics]

common/physics_ticks_per_second=120
; Bound catch-up work during a chain; at 60 fps this still supplies every 120 Hz step.
common/max_physics_steps_per_frame=2
3d/physics_engine="Jolt Physics"
jolt_physics_3d/limits/temporary_memory_buffer_size=128
jolt_physics_3d/limits/world_boundary_shape_size=8000.0
jolt_physics_3d/limits/max_bodies=20480
jolt_physics_3d/limits/max_contact_constraints=32768
3d/default_gravity=9.81

[rendering]

; 8192 instance-uniform meshes: 16-player suburbs, actors, debris and overlapping menu retirement.
; Godot reserves 16 vec4 slots per mesh; this is a 2 MiB storage buffer.
limits/global_shader_variables/buffer_size=131072

; Match Linux's Vulkan path: D3D12 RGB float curve textures are unsupported under Proton on some GPUs.
rendering_device/driver.windows="vulkan"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=3
environment/ssil/quality=1
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true

[shader_globals]

reveal_window={
"type": "vec4",
"value": Vector4(1, 0, -100000, 100000)
}
